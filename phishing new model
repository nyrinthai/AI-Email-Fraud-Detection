        "    print(\"Top 20 words/phrases (RF importances):\")\n",
        "\n",
        "print(top20.to_string())"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Step 14B \u2014 SHAP Explainability\n",
        "\n",
        "Shows **which specific words** drove each prediction.\n",
        "Red words push toward phishing; blue words push toward legitimate.\n",
        "\n",
        "This addresses the model behavior transparency requirement."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "outputs": [],
      "source": [
        "import shap\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "explainer = shap.LinearExplainer(\n",
        "    best_model,\n",
        "    X_train_tfidf,\n",
        "    feature_perturbation='interventional'\n",
        ")\n",
        "\n",
        "feature_names = vectorizer.get_feature_names_out()\n",
        "\n",
        "y_test_arr   = np.array(y_test)\n",
        "test_indices = np.arange(len(y_test_arr))\n",
        "\n",
        "phish_pos = test_indices[y_test_arr == 1][0]\n",
        "legit_pos  = test_indices[y_test_arr == 0][0]\n",
        "\n",
        "for label_name, pos in [(\"PHISHING\", phish_pos), (\"LEGITIMATE\", legit_pos)]:\n",
        "    sample    = X_test_tfidf[pos]\n",
        "    shap_vals = explainer.shap_values(sample)\n",
        "    vals_1d   = np.array(shap_vals).flatten()\n",
        "\n",
        "    word_impacts = pd.Series(vals_1d, index=feature_names)\n",
        "\n",
        "    print(f\"\\n{'='*55}\")\n",
        "    print(f\"  SHAP Explanation \u2014 {label_name} email\")\n",
        "    print(f\"{'='*55}\")\n",
        "    print(\"Top 10 words PUSHING TOWARD phishing:\")\n",
        "    print(word_impacts.nlargest(10).to_string())\n",
        "    print(\"\\nTop 10 words PUSHING TOWARD legitimate:\")\n",
        "    print(word_impacts.nsmallest(10).to_string())\n",
        "\n",
        "    sample_dense = sample.toarray().flatten()\n",
        "    expected_val = explainer.expected_value\n",
        "    if hasattr(expected_val, '__len__'):\n",
        "        expected_val = float(expected_val[1])\n",
        "\n",
        "    shap.force_plot(\n",
        "        expected_val,\n",
        "        vals_1d,\n",
        "        sample_dense,\n",
        "        feature_names=feature_names,\n",
        "        matplotlib=True,\n",
        "        show=False,\n",
        "        figsize=(18, 4)\n",
        "    )\n",
        "    plt.title(f\"SHAP Force Plot \u2014 {label_name} email\", fontsize=13)\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(f'shap_{label_name.lower()}.png', dpi=150, bbox_inches='tight')\n",
        "    plt.show()\n",
        "    print(f\"Saved: shap_{label_name.lower()}.png\")\n",
        "\n",
        "from google.colab import files\n",
        "files.download('shap_phishing.png')\n",
        "files.download('shap_legitimate.png')\n",
        "print(\"\\nSHAP images downloaded.\")"
      ]
    },
