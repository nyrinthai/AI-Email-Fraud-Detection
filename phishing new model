    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Step 13 \u2014 Integration test"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "outputs": [],
      "source": [
        "m = joblib.load('model/artifacts/model.pkl')\n",
        "v = joblib.load('model/artifacts/vectorizer.pkl')\n",
        "\n",
        "test_emails = [\n",
        "    \"URGENT: Your account has been compromised. Click here immediately to verify your identity or your account will be suspended within 24 hours.\",\n",
        "    \"Hi team, attaching the notes from this morning's meeting. Let me know if you have any questions before Friday's deadline. Thanks!\",\n",
        "    \"Dear customer, we noticed unusual activity on your PayPal account. Please confirm your password at http://paypa1-verify.com to secure your account.\"\n",
        "]\n",
        "\n",
        "for i, email in enumerate(test_emails, 1):\n",
        "    clean   = scrub_pii(email)\n",
        "    pred    = m.predict(v.transform([clean]))[0]\n",
        "    prob    = m.predict_proba(v.transform([clean]))[0][1]\n",
        "    verdict = 'PHISHING' if pred == 1 else 'LEGITIMATE'\n",
        "    print(f\"\\nEmail {i}: \\\"{email[:60]}...\\\"\")\n",
        "    print(f\"  Verdict: {verdict}  (phishing confidence: {prob:.1%})\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Step 14 \u2014 Top 20 phishing indicator words"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "\n",
        "feature_names = vectorizer.get_feature_names_out()\n",
        "\n",
        "if best_name == 'Logistic Regression':\n",
        "    top20 = pd.Series(best_model.coef_[0], index=feature_names).nlargest(20)\n",
